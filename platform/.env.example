# =============================================================================
# KOORAKIT — World Cup 2026 Platform · Environment template (Req 9.4)
# -----------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# DO NOT commit real secrets — every value below is a placeholder.
# Secrets are provided to the app exclusively via environment variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Req 4.2) — REQUIRED
# -----------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma (`datasource db`) and the seed.
# Use Vercel Postgres or any external PostgreSQL instance.
DATABASE_URL="postgresql://user:password@localhost:5432/koorakit?schema=public"

# -----------------------------------------------------------------------------
# Authentication — NextAuth (Req 5.1, 5.4, 19.2) — REQUIRED
# -----------------------------------------------------------------------------
# Canonical, externally reachable base URL of the deployment. NextAuth uses it
# to build callback URLs. In local dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign/encrypt the session JWT. Must be a long random string and
# must match the secret read by the middleware auth gate.
# Generate one with: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth provider credentials (optional sign-in method). Leave blank to
# disable Google sign-in; the provider simply fails to authenticate when unset.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email provider for magic-link sign-in (optional). SMTP connection string in
# the form: smtp://user:password@smtp.example.com:587
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
# Address that magic-link emails are sent from.
# EMAIL_FROM="KOORAKIT <no-reply@koorakit.com>"

# -----------------------------------------------------------------------------
# Site / SEO (Req 8.1, 20.3)
# -----------------------------------------------------------------------------
# Absolute base URL used to build canonical/OpenGraph URLs in metadata.
# Falls back to a built-in default when unset; set it in every deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Analytics & Advertising (Req 14.1–14.4) — TIER 2, public (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=""

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
NEXT_PUBLIC_GTM_ID=""

# Google AdSense publisher client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
NEXT_PUBLIC_ADSENSE_CLIENT=""

# -----------------------------------------------------------------------------
# Caching — Upstash Redis (Req 16.3, 17.4) — TIER 3, OPTIONAL
# -----------------------------------------------------------------------------
# When unset, hot-read caching gracefully falls back to ISR / in-process
# behavior with no functional loss. Configure both vars to enable Redis.
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
